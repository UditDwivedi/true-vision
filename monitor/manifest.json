{
    "name" : "True-Vision",
    "version" : "1.0",
    "manifest_version" : 3,
    "description" : "True Vision to monitor your website",
    "action" : {
        "default_popup" : "popup.html"
    },
    "background" : {
        "service_worker" : "background.js"
    },
    "permissions": ["tabs", "activeTab", "desktopCapture"],
    "content_scripts" : [
        {
            "matches" : ["<all_urls>"],
            "js" : ["content.js"]
        }
    ]    
}