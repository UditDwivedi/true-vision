{
    "manifest_version": 3,
    "name": "Screen Streamer",
    "version": "1.0",
    "description": "Streams screen recording to a Flask app.",
    "permissions": ["tabs", "activeTab"],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": ["http://127.0.0.1:3000/*"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "128": "icon128.png"
        }
    }
}
